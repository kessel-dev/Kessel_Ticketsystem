                      "Common"
                    ]
                  },
                  {
                    "equals": [
                      "@outputs('Get_Ticket_Information')?['body/TicketType/Value']",
                      "@outputs('Get_Transition_Information')?['body/EntityType']"
                    ]
                  }
                ]
              },
              {
                "equals": [
                  "@outputs('Get_Ticket_Information')?['body/Status/Value']",
