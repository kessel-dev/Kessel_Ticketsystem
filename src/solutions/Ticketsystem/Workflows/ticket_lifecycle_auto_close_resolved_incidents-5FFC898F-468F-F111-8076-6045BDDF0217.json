{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "kse_cnref_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "ev_sp_site": {
          "defaultValue": "https://kesselgruppe.sharepoint.com/sites/DEVTicketsystem",
          "type": "String"
        },
        "ev_sp_list_tickets": {
          "defaultValue": "e4f994ec-26c7-4943-94b8-fb5c6c663b0b",
          "type": "String"
        },
        "ev_sp_list_comments": {
          "defaultValue": "6cf22d82-e9ed-4d53-95d4-0d84dcb119cd",
          "type": "String"
        }
      },
      "triggers": {
        "Every_hour": {
          "recurrence": {
            "frequency": "Hour",
            "interval": 1
          },
          "metadata": {
            "operationMetadataId": "6b30a850-6603-4502-b892-77992c5df1db"
          },
          "type": "Recurrence",
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Get_Resolved_Incidents": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "be0de164-daff-4a6a-80ba-1e238108f6d7"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('ev_sp_site')",
              "table": "@parameters('ev_sp_list_tickets')",
              "$filter": "Status eq 'Gelöst'",
              "$top": 5000
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Apply_to_each_resolved_incident": {
          "foreach": "@body('Get_Resolved_Incidents')?['value']",
          "actions": {
            "Close_after_seven_days": {
              "actions": {
                "Update_Ticket_Status": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "4dd47677-456f-40a3-9fe7-09b819db548c"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ev_sp_site')",
                      "table": "@parameters('ev_sp_list_tickets')",
                      "id": "@items('Apply_to_each_resolved_incident')?['ID']",
                      "item/Status/Value": "Geschlossen"
                    }
                  }
                },
                "Create_Closure_System_Comment": {
                  "runAfter": {
                    "Update_Ticket_Status": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "2bad0431-7e3d-4572-b37e-c32bfe45d07e"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ev_sp_site')",
                      "table": "@parameters('ev_sp_list_comments')",
                      "item/Title": "@items('Apply_to_each_resolved_incident')?['Title']",
                      "item/TicketNumber": "@items('Apply_to_each_resolved_incident')?['Title']",
                      "item/Comment": "Status automatisch auf Geschlossen gesetzt: sieben Tage nach der Lösung (Lifecycle).",
                      "item/CommentBy": "Ticketsystem",
                      "item/CommentType/Value": "System Information",
                      "item/IsInternal": false
                    }
                  }
                }
              },
              "runAfter": {},
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@items('Apply_to_each_resolved_incident')?['TicketType']?['Value']",
                      "Incident"
                    ]
                  },
                  {
                    "equals": [
                      "@items('Apply_to_each_resolved_incident')?['Status']?['Value']",
                      "Gelöst"
                    ]
                  },
                  {
                    "lessOrEquals": [
                      "@coalesce(items('Apply_to_each_resolved_incident')?['ResolvedAt'], items('Apply_to_each_resolved_incident')?['Modified'])",
                      "@addDays(utcNow(), -7)"
                    ]
                  }
                ]
              },
              "metadata": {
                "operationMetadataId": "4f83cd1d-472b-4f59-a919-27c7cc38b950"
              },
              "type": "If"
            }
          },
          "runAfter": {
            "Get_Resolved_Incidents": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8b827f29-ee5d-4b72-a2bd-9a56e6613866"
          },
          "type": "Foreach"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}